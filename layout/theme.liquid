<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1F2A44">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged_with' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@800;900&display=swap" rel="stylesheet">

    <style>
      :root {
        --color-navy: {{ settings.color_navy }};
        --color-orange: {{ settings.color_orange }};
        --color-teal: {{ settings.color_teal }};
        --color-cream: {{ settings.color_cream }};
        --color-peach: {{ settings.color_peach }};
        --color-gold: {{ settings.color_gold }};
        --color-rust: {{ settings.color_rust }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {% if settings.cart_ajax %}"drawer"{% else %}"page"{% endif %},
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          added: {{ 'products.added' | t | json }},
          viewCart: {{ 'products.view_cart' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          savePercent: {{ 'products.save_percent' | t: percent: '[percent]' | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_ajax and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}
    <div class="toast" id="CartToast" role="status" aria-live="polite" hidden></div>

    {%- if template.name == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }}
          {%- if settings.logo != blank -%},
          "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif %}
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}&type=product' | json }},
            "query-input": "required name=search_term_string"
          }
        }
      </script>
    {%- endif -%}
  </body>
</html>
