      },
      {
        "type": "text",
        "id": "delivery_days_global",
        "label": "International warehouse delivery",
        "default": "7–14"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_ajax",
