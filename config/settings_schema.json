[
  {
    "name": "theme_info",
    "theme_name": "WaggleKin",
    "theme_version": "1.0.0",
    "theme_author": "WaggleKin",
    "theme_documentation_url": "https://wagglekin.com",
    "theme_support_url": "https://wagglekin.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_navy",
        "label": "Navy (text, dark sections)",
        "default": "#1F2A44"
      },
      {
        "type": "color",
        "id": "color_orange",
        "label": "Orange (primary buttons, dog)",
        "default": "#F18C2B"
      },
      {
        "type": "color",
        "id": "color_teal",
        "label": "Teal (secondary, cat)",
        "default": "#2DB3A3"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream (page background)",
        "default": "#FFF7EF"
      },
      {
        "type": "color",
        "id": "color_peach",
        "label": "Peach (panels)",
        "default": "#FDEBD7"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold (accent labels on dark)",
        "default": "#F5C842"
      },
      {
        "type": "color",
        "id": "color_rust",
        "label": "Rust (eyebrow text, dog ears)",
        "default": "#B5561A"
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Leave empty to use the built-in cat & dog mark with the store name."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Shipping",
    "settings": [
      {
        "type": "paragraph",
        "content": "Write [threshold] in the announcement bar, trust bar or product perks to show the free-shipping threshold for the visitor's country."
      },
      {
        "type": "text",
        "id": "free_shipping_thresholds",
        "label": "Free-shipping threshold per country",
        "info": "Country code:amount, comma-separated. Keep these in sync with Settings → Shipping and delivery.",
        "default": "US:$49, CA:C$69, GB:£39, AU:A$75"
      },
      {
        "type": "text",
        "id": "free_shipping_default",
        "label": "Threshold for other countries",
        "default": "$49"
      },
      {
        "type": "header",
        "content": "Delivery times"
      },
      {
        "type": "paragraph",
        "content": "Tag products ship:us (US warehouse) or ship:global (international warehouse) to show a delivery badge and include them in the Fast US Shipping / Value Picks collections."
      },
      {
        "type": "text",
        "id": "delivery_days_us",
        "label": "US warehouse delivery",
        "default": "3–7"
      },
      {
        "type": "text",
        "id": "delivery_days_global",
        "label": "International warehouse delivery",
        "default": "7–14"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_ajax",
        "label": "Add to cart without leaving the page",
        "default": true
      }
    ]
  },
  {
    "name": "Tracking & analytics",
    "settings": [
      {
        "type": "paragraph",
        "content": "Paste an ID to switch a tag on; leave it empty to switch it off. Tags respect the visitor's privacy choices. These cover the storefront. Checkout and purchases are tracked by the WaggleKin custom pixel in Settings → Customer events (see docs/tracking.md)."
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "Google Analytics 4 measurement ID",
        "placeholder": "G-XXXXXXXXXX",
        "info": "Google Analytics → Admin → Data streams → Web."
      },
      {
        "type": "text",
        "id": "google_ads_id",
        "label": "Google Ads tag ID",
        "placeholder": "AW-XXXXXXXXXX",
        "info": "Google Ads → Goals → Conversions → Settings → Google tag. Used for remarketing audiences."
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta pixel (dataset) ID",
        "placeholder": "123456789012345",
        "info": "Meta Events Manager → Data sources. Numbers only."
      },
      {
        "type": "text",
        "id": "tiktok_pixel_id",
        "label": "TikTok pixel ID",
        "placeholder": "CXXXXXXXXXXXXXXXXXXX",
        "info": "TikTok Ads Manager → Tools → Events → Web events."
      },
      {
        "type": "text",
        "id": "clarity_project_id",
        "label": "Microsoft Clarity project ID",
        "placeholder": "abcd1234ef",
        "info": "Clarity → Settings → Overview → Project ID."
      }
    ]
  }
]
