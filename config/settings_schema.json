  {
    "name": "Shipping",
    "settings": [
      {
        "type": "paragraph",
        "content": "Write [threshold] in the announcement bar, trust bar or product perks to show the free-shipping threshold for the visitor's country."
      },
      {
        "type": "text",
        "id": "free_shipping_thresholds",
        "label": "Free-shipping threshold per country",
