<header class="site-header">
  <div class="page-width site-header__inner">
    <button class="site-header__toggle icon-btn" type="button" aria-controls="MobileNav" aria-expanded="false" data-nav-toggle>
      <span class="visually-hidden">{{ 'general.menu' | t }}</span>
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="site-logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 520 | image_tag: width: settings.logo_width, alt: shop.name, loading: 'eager', class: 'site-logo__img' }}
      {%- else -%}
        <span class="site-logo__mark">{% render 'illustration', name: 'logo-mark' %}</span>
        <span class="site-logo__text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" id="MobileNav">
        {%- for link in section.settings.menu.links -%}
          {%- assign highlight = false -%}
          {%- if section.settings.highlight_last and forloop.last -%}{%- assign highlight = true -%}{%- endif -%}
          {%- if link.links.size > 0 -%}
            <li class="site-nav__item site-nav__item--parent">
              <details class="site-nav__dropdown" data-nav-dropdown>
                <summary class="site-nav__link{% if link.active or link.child_active %} is-active{% endif %}{% if highlight %} site-nav__link--highlight{% endif %}">
                  {{ link.title }}<span class="site-nav__caret" aria-hidden="true"></span>
                </summary>
                <ul class="site-nav__submenu">
                  {%- if link.url contains '/collections/' -%}
                    <li><a href="{{ link.url }}" class="site-nav__sublink site-nav__sublink--all">{{ 'general.shop_all_named' | t: title: link.title }}</a></li>
                  {%- endif -%}
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}" class="site-nav__sublink{% if child.active %} is-active{% endif %}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            </li>
          {%- else -%}
            <li class="site-nav__item">
              <a href="{{ link.url }}" class="site-nav__link{% if link.active %} is-active{% endif %}{% if highlight %} site-nav__link--highlight{% endif %}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.show_country_selector -%}
          <li class="site-nav__country">{% render 'country-selector', id: 'MobileNav', style: 'full' %}</li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if section.settings.show_country_selector -%}
        <div class="site-header__country">{% render 'country-selector', id: 'Header', style: 'compact' %}</div>
      {%- endif -%}
      <a href="{{ routes.search_url }}" class="icon-btn" data-search-toggle aria-controls="SearchDrawer" aria-expanded="false">
        <span class="visually-hidden">{{ 'general.search' | t }}</span>
        {% render 'icon', name: 'search' %}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn">
          <span class="visually-hidden">{{ 'general.account' | t }}</span>
          {% render 'icon', name: 'account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="cart-pill">
        <span class="visually-hidden">{{ 'general.cart' | t }}</span>
        {% render 'icon', name: 'bag', icon_size: 16 %}
        <span class="cart-pill__count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="search-drawer" id="SearchDrawer" data-search-drawer hidden>
    <form action="{{ routes.search_url }}" method="get" role="search" class="page-width search-drawer__form" data-predictive-form>
      <input type="hidden" name="type" value="product">
      <label for="HeaderSearch" class="visually-hidden">{{ 'general.search' | t }}</label>
      <input id="HeaderSearch" class="input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" aria-controls="PredictiveResults" aria-autocomplete="list" data-predictive-input>
      <button type="submit" class="btn btn--navy">{{ 'general.search' | t }}</button>
    </form>
    <div class="page-width"><div id="PredictiveResults" class="predictive-wrap" data-predictive-target aria-live="polite"></div></div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "highlight_last", "label": "Highlight last menu item (e.g. WaggleKin TV)", "default": true },
    { "type": "checkbox", "id": "show_country_selector", "label": "Show country/currency selector", "info": "Lists the countries in your active Shopify Markets.", "default": true }
  ]
}
{% endschema %}
