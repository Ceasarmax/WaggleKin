<section class="section featured-products">
  <div class="page-width">
    <div class="section__head">
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="section__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="link-arrow">{{ 'general.shop_all' | t }} &rarr;</a>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <article class="product-card product-card--placeholder">
            <div class="product-card__media product-card__media--peach">{% render 'illustration', name: 'paw' %}</div>
            <div class="product-card__body">
              <p class="product-card__type">Dogs &amp; Cats</p>
              <h3 class="product-card__title">Product title</h3>
              <div class="product-card__footer"><div class="price"><span class="price__current">{{ 1999 | money }}</span></div></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pack favourites" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Hand-picked for cats, dogs — and homes with both." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 16, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
