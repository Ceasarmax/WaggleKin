<section class="section section--tight">
  <div class="page-width">
    <div class="newsletter">
      <div>
        <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="newsletter__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', class: 'newsletter__form', id: 'NewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="NewsletterEmail" class="input input--pill" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
          <button type="submit" class="btn btn--navy">{{ section.settings.button_label }}</button>
          {%- if form.errors -%}<p class="newsletter__error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the pack — get 10% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "New episodes, new arrivals and members-only deals. No spam, just good boys and girls." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
