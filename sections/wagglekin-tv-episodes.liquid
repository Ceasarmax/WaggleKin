<section class="tv-episodes" id="episodes">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="tv-episodes__text">{{ section.settings.text }}</div>{%- endif -%}

    <ul class="tv-episodes__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign ep_video = block.settings.video -%}
        {%- if ep_video == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        {%- capture ep_name -%}{{ block.settings.title }} {{ block.settings.part }}{%- endcapture -%}
        <li class="tv-episode" {{ block.shopify_attributes }}>
          <div class="tv__player tv__player--{{ section.settings.video_shape }}"{% if ep_video != blank %} data-video-player{% endif %}>
            {%- if ep_video != blank -%}
              <template data-video-template>
                {{ ep_video | video_tag: controls: true, playsinline: true, preload: 'auto', image_size: '720x' }}
              </template>
              <div class="tv__poster">
                {{ ep_video.preview_image | image_url: width: 720 | image_tag: loading: 'lazy', class: 'tv__poster-img', alt: '', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360, 540, 720' }}
              </div>
              <button type="button" class="tv__play" data-video-play>
                <span class="visually-hidden">{{ 'accessibility.play_episode' | t: title: ep_name }}</span>
                {% render 'icon', name: 'play', icon_size: 22 %}
              </button>
              {%- assign secs = ep_video.duration | divided_by: 1000 -%}
              {%- assign rem = secs | modulo: 60 -%}
              <span class="tv-episode__duration">{{ secs | divided_by: 60 }}:{% if rem < 10 %}0{% endif %}{{ rem }}</span>
            {%- else -%}
              <span class="tv-episode__empty">Choose a video for this episode</span>
            {%- endif -%}
          </div>
          <p class="tv-episode__title">{{ block.settings.title }}{% if block.settings.part != blank %}<span class="tv-episode__part">{{ block.settings.part }}</span>{% endif %}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "WaggleKin TV episodes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All episodes" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every episode of WaggleKin TV, in order. Press play to watch with sound.</p>" },
    { "type": "select", "id": "video_shape", "label": "Video shape", "default": "square", "options": [
      { "value": "square", "label": "Square (1:1)" },
      { "value": "portrait", "label": "Portrait (9:16)" }
    ] }
  ],
  "blocks": [
    {
      "type": "episode",
      "name": "Episode",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (uploaded to Shopify)", "info": "Episodes without a video stay hidden on the store." },
        { "type": "text", "id": "title", "label": "Title", "default": "Episode title" },
        { "type": "text", "id": "part", "label": "Part", "default": "Part 1" }
      ]
    }
  ],
  "presets": [{ "name": "WaggleKin TV episodes" }]
}
{% endschema %}
