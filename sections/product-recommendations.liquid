{%- comment -%}
  "You may also like" on product pages.
  - First paint: products from the same category collection (works for a brand-new store with no sales data).
  - theme.js then asks Shopify's Product Recommendations API (intent=related) for this section and swaps in
    Shopify's picks when it returns any. The same section also renders the "Pairs well with" list
    (intent=complementary, set up in the free Shopify Search & Discovery app) for the product page.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign skip_handles = 'frontpage,all,fast-us-shipping,value-picks,new-arrivals,pack-favourites,holiday-shop,gifts,bundles,dogs,cats' | split: ','
-%}
<section class="section product-recommendations" data-recommendations data-section-id="{{ section.id }}" data-url="{{ routes.product_recommendations_url }}" data-product-id="{{ product.id }}" data-limit="{{ limit }}" data-ship="{% if product.tags contains 'ship:us' %}us{% elsif product.tags contains 'ship:global' %}global{% endif %}" data-use-shopify="{{ section.settings.use_shopify }}">
  {%- if recommendations.performed -%}
    {%- if recommendations.intent == 'complementary' -%}
      <div data-recommendations-complementary>
        {%- if recommendations.products_count > 0 -%}
          <h2 class="product-complementary__title">{{ 'products.pairs_well_with' | t }}</h2>
          <ul class="mini-list">
            {%- for rec in recommendations.products -%}
              <li>{% render 'mini-product', product: rec %}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- else -%}
      <div data-recommendations-related>
        {%- if recommendations.products_count > 0 -%}
          <div class="product-grid">
            {%- for rec in recommendations.products -%}
              {% render 'product-card', product: rec %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- elsif product != blank -%}
    {%- liquid
      assign source = nil
      for c in product.collections
        unless skip_handles contains c.handle
          if c.products_count > 1
            assign source = c
            break
          endif
        endunless
      endfor
      if source == nil
        for c in product.collections
          unless c.handle == 'frontpage' or c.handle == 'all'
            if c.products_count > 1
              assign source = c
              break
            endif
          endunless
        endfor
      endif
    -%}
    {%- liquid
      assign is_cat = false
      assign is_dog = false
      if product.tags contains 'Cats'
        assign is_cat = true
      endif
      if product.tags contains 'Dogs'
        assign is_dog = true
      endif
      assign is_food = false
      if product.tags contains 'Food'
        assign is_food = true
      endif
      assign shown = 0
      assign shown_ids = ',' | append: product.id | append: ','
      assign max_price = product.price_max | times: 4
      if max_price < 6000
        assign max_price = 6000
      endif
    -%}
    {%- capture rec_cards -%}
          {%- for pass in (1..2) -%}
            {%- if pass == 1 -%}
              {%- assign pool = source.products -%}
            {%- else -%}
              {%- if is_cat and is_dog == false -%}
                {%- assign pool = collections['cats'].products -%}
              {%- elsif is_dog and is_cat == false -%}
                {%- assign pool = collections['dogs'].products -%}
              {%- else -%}
                {%- assign pool = collections['pack-favourites'].products -%}
              {%- endif -%}
            {%- endif -%}
            {%- for rec in pool -%}
              {%- if shown >= limit -%}{%- break -%}{%- endif -%}
              {%- liquid
                assign key = ',' | append: rec.id | append: ','
                assign skip_rec = false
                if shown_ids contains key or rec.available == false
                  assign skip_rec = true
                endif
                if product.tags contains 'ship:us' and rec.tags contains 'ship:global'
                  assign skip_rec = true
                endif
                if is_cat and is_dog == false
                  unless rec.tags contains 'Cats'
                    assign skip_rec = true
                  endunless
                endif
                if is_dog and is_cat == false
                  unless rec.tags contains 'Dogs'
                    assign skip_rec = true
                  endunless
                endif
                if is_food == false and rec.tags contains 'Food'
                  assign skip_rec = true
                endif
                if rec.price_min > max_price
                  assign skip_rec = true
                endif
              -%}
              {%- unless skip_rec -%}
                {% render 'product-card', product: rec %}
                {%- assign shown = shown | plus: 1 -%}
                {%- assign shown_ids = shown_ids | append: key -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}
    {%- endcapture -%}
    {%- if shown > 0 -%}
    <div class="page-width">
      <div class="section__head">
        <h2 class="section__title">{{ section.settings.heading }}</h2>
        {%- if source -%}<a href="{{ source.url }}" class="link-arrow">{{ 'general.shop_all_named' | t: title: source.title }} &rarr;</a>{%- endif -%}
      </div>
      <div data-recommendations-body>
        <div class="product-grid">
          {{ rec_cards }}
        </div>
      </div>
    </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "use_shopify", "label": "Use Shopify's automatic recommendations", "info": "Off: show products from the same category, for the same pet and shipping speed (best for a new store). Turn on once the store has a few months of sales, when Shopify's picks get smarter.", "default": false }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
