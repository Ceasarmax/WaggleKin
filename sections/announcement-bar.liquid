{%- if section.settings.text != blank -%}
  {%- capture threshold -%}{% render 'shipping-threshold' %}{%- endcapture -%}
  <div class="announcement-bar">
    <p class="page-width">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
      {{ section.settings.text | replace: '[threshold]', threshold }}
      {%- if section.settings.link != blank -%}</a>{%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over [threshold] · Shipping to the US, UK, Canada & Australia · 30-day happy-pet returns" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
