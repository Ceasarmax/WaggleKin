<section class="section section--tight">
  <div class="page-width">
    <div class="cta-banner cta-banner--{{ section.settings.color }}">
      <div>
        <h2 class="cta-banner__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="cta-banner__text">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--navy">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what your pack needs?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Tell us about your cats and dogs in 60 seconds and we’ll suggest the right picks." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the pack quiz" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "color", "label": "Colour", "default": "peach", "options": [
      { "value": "peach", "label": "Peach" },
      { "value": "mint", "label": "Mint" }
    ] }
  ],
  "presets": [{ "name": "Call to action" }]
}
{% endschema %}
