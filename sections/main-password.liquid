<section class="password-page">
  <div class="page-width page-width--narrow text-center">
    <div class="password-page__art">{% render 'illustration', name: 'hero-pets' %}</div>
    <h1 class="section__title">{{ shop.name }}</h1>
    <p class="eyebrow">{{ 'password.opening_soon' | t }}</p>
    {%- if shop.password_message != blank -%}<p class="section__sub">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form newsletter__form--center' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input class="input input--pill" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required aria-label="{{ 'newsletter.label' | t }}">
        <button type="submit" class="btn btn--orange">Notify me</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password-page__login">
      <summary>{{ 'password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input class="input input--pill" type="password" name="password" placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
        <button type="submit" class="btn btn--navy">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password" }
{% endschema %}
