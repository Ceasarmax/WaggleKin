<section class="tv" id="wagglekin-tv">
  <div class="page-width tv__grid">
    <div class="tv__player" data-video-player>
      {%- if section.settings.episode_label != blank -%}<span class="tv__label">{{ section.settings.episode_label }}</span>{%- endif -%}

      {%- if section.settings.video != blank -%}
        <template data-video-template>
          {%- if section.settings.video.type == 'youtube' -%}
            <iframe src="https://www.youtube-nocookie.com/embed/{{ section.settings.video.id }}?autoplay=1&rel=0" title="{{ section.settings.episode_label | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video.id }}?autoplay=1" title="{{ section.settings.episode_label | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}

      <div class="tv__poster">
        {%- if section.settings.poster != blank -%}
          {{ section.settings.poster | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'tv__poster-img' }}
        {%- else -%}
          {% render 'illustration', name: 'tv-bubbles' %}
        {%- endif -%}
      </div>

      {%- if section.settings.video != blank -%}
        <button type="button" class="tv__play" data-video-play>
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
          {% render 'icon', name: 'play', icon_size: 24 %}
        </button>
      {%- elsif section.settings.watch_link != blank -%}
        <a href="{{ section.settings.watch_link }}" class="tv__play" target="_blank" rel="noopener">
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
          {% render 'icon', name: 'play', icon_size: 24 %}
        </a>
      {%- else -%}
        <span class="tv__play" aria-hidden="true">{% render 'icon', name: 'play', icon_size: 24 %}</span>
      {%- endif -%}
    </div>

    <div class="tv__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tv__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="tv__text">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.settings.products != blank -%}
        <ul class="tv__products">
          {%- for product in section.settings.products -%}
            <li><a href="{{ product.url }}"><span>{{ product.title }}</span><span>{{ product.price | money }}</span></a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--orange">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WaggleKin TV",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WaggleKin TV" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The pack has a lot to say." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our talking-pet sitcom, with new episodes every week on YouTube, TikTok and Instagram. Spotted something in the show? Shop it below.</p>" },
    { "type": "header", "content": "Episode" },
    { "type": "text", "id": "episode_label", "label": "Episode label", "default": "Episode 1 · [Episode title]" },
    { "type": "video_url", "id": "video", "label": "YouTube or Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "url", "id": "watch_link", "label": "Watch link (if no video above)", "info": "e.g. a TikTok or Instagram post" },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Optional. Replaces the talking-pets illustration." },
    { "type": "product_list", "id": "products", "label": "Products in this episode", "limit": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the episode" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "WaggleKin TV" }]
}
{% endschema %}
