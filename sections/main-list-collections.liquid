<section class="section">
  <div class="page-width">
    <h1 class="section__title">{{ section.settings.heading }}</h1>
    <ul class="collection-list">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <li>
            <a href="{{ collection.url }}" class="collection-list__item">
              <span class="collection-list__title">{{ collection.title }}</span>
              <span class="collection-list__count">{{ 'collections.products_count' | t: count: collection.products_count }}</span>
            </a>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the pack" }
  ]
}
{% endschema %}
