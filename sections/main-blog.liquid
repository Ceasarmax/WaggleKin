{%- paginate blog.articles by 12 -%}
<section class="section">
  <div class="page-width">
    <h1 class="section__title">{{ blog.title }}</h1>
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <article class="article-card">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="article-card__media">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy' }}</a>
          {%- endif -%}
          <div class="article-card__body">
            <p class="eyebrow">{{ article.published_at | date: format: 'month_day_year' }}</p>
            <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            <a href="{{ article.url }}" class="link-arrow">{{ 'blogs.read_more' | t }} &rarr;</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog" }
{% endschema %}
