<section class="section cart-page">
  <div class="page-width page-width--narrow">
    <h1 class="section__title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form" novalidate>
        <ul class="cart-items">
          {%- for item in cart.items -%}
            {%- capture illo -%}{% render 'product-illustration-key', product: item.product %}{%- endcapture -%}
            {%- assign illo_parts = illo | strip | split: '|' -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media product-card__media--{{ illo_parts[1] }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
                {%- else -%}
                  {% render 'illustration', name: illo_parts[0] %}
                {%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-item__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
                {%- endfor -%}
                <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
              </div>
              <div class="cart-item__qty">
                <label for="Qty-{{ item.key }}" class="visually-hidden">{{ 'products.quantity' | t }}</label>
                <input id="Qty-{{ item.key }}" class="input input--qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </div>
              <div class="cart-item__price">
                {%- if item.original_line_price != item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                <strong>{{ item.final_line_price | money }}</strong>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-summary">
          <label for="CartNote" class="cart-summary__label">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note" class="input" rows="2">{{ cart.note }}</textarea>
          {%- for discount in cart.cart_level_discount_applications -%}
            <p class="cart-summary__row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="cart-summary__row cart-summary__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
          <p class="cart-summary__small">{{ 'cart.taxes_and_shipping' | t }}</p>
          <div class="btn-row">
            <button type="submit" name="update" class="btn btn--outline">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--orange btn--lg">{{ 'cart.checkout' | t }}</button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="cart-summary__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <p class="empty-state">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--orange">{{ 'general.continue_shopping' | t }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart" }
{% endschema %}
