{%- comment -%}
  Renders a single product card for the product in context. Used by theme.js through the Section Rendering API,
  e.g. /products/<handle>?section_id=product-card-fragment, to build the "Recently viewed" carousel.
  Not meant to be added to templates.
{%- endcomment -%}
{%- if product != blank and product.available -%}
  <div data-card-fragment data-product-id="{{ product.id }}">
    {% render 'product-card', product: product %}
  </div>
{%- endif -%}

{% schema %}
{ "name": "Product card (fragment)" }
{% endschema %}
