<section class="section section--tight">
  <div class="page-width">
    <h1 class="section__title">
      {%- if search.performed -%}{{ 'search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search' | t }}{%- endif -%}
    </h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product">
      <label for="SearchPage" class="visually-hidden">{{ 'general.search' | t }}</label>
      <input id="SearchPage" class="input input--pill" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="btn btn--navy">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="collection-toolbar__count">{{ 'collections.products_count' | t: count: search.results_count }}</p>
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- liquid
                  assign eager = false
                  if forloop.index <= 4 and paginate.current_page == 1
                    assign eager = true
                  endif
                -%}
                {% render 'product-card', product: item, eager: eager %}
              {%- else -%}
                <article class="product-card product-card--text">
                  <div class="product-card__body">
                    <h2 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                    <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- else -%}
          <p class="empty-state">{{ 'search.no_results' | t: terms: search.terms }} {{ 'search.try_these' | t }}</p>
          {%- assign fallback = collections['pack-favourites'] -%}
          {%- if fallback.products_count > 0 -%}
            <h2 class="section__title search-page__fallback-title">{{ 'search.popular' | t }}</h2>
            <div class="product-grid">
              {%- for product in fallback.products limit: 8 -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search" }
{% endschema %}
