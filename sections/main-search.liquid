<section class="section">
  <div class="page-width">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label for="SearchPage" class="visually-hidden">{{ 'general.search' | t }}</label>
      <input id="SearchPage" class="input input--pill" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="btn btn--navy">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <h1 class="section__title">{{ 'search.results_for' | t: terms: search.terms }}</h1>
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <article class="product-card product-card--text">
                  <div class="product-card__body">
                    <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- else -%}
          <p class="empty-state">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search" }
{% endschema %}
