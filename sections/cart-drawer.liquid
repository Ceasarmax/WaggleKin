{%- comment -%}
  Slide-out cart, rendered once in layout/theme.liquid and re-rendered by theme.js through the
  Section Rendering API (?sections=cart-drawer) after every add / quantity change.
{%- endcomment -%}
{%- if settings.cart_ajax -%}
<div class="cart-drawer" id="CartDrawer" data-cart-drawer>
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1" data-cart-panel>
    <div class="cart-drawer__head">
      <h2 id="CartDrawerTitle" class="cart-drawer__title">{{ 'cart.title' | t }} <span class="cart-drawer__count">({{ cart.item_count }})</span></h2>
      <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count > 0 -%}
      {% render 'free-shipping-bar' %}

      <ul class="drawer-items">
        {%- for item in cart.items -%}
          <li class="drawer-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
            <a href="{{ item.url }}" class="drawer-item__media">
              {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.product.title | escape }}{%- endif -%}
            </a>
            <div class="drawer-item__info">
              <a href="{{ item.url }}" class="drawer-item__title">{{ item.product.title }}</a>
              {%- if item.product.variants.size > 1 -%}<p class="drawer-item__variant">{{ item.variant.title }}</p>{%- endif -%}
              {%- unless item.variant.available -%}<p class="drawer-item__soldout">{{ 'cart.item_sold_out' | t }}</p>{%- endunless -%}
              {% render 'delivery-badge', product: item.product %}
              {%- for discount in item.line_level_discount_allocations -%}
                <p class="drawer-item__variant">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
              {%- endfor -%}
              <div class="drawer-item__controls">
                <div class="qty qty--sm">
                  <button type="button" class="qty__btn" data-line-change="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'products.decrease_quantity' | t }}">&minus;</button>
                  <span class="qty__value" aria-live="polite">{{ item.quantity }}</span>
                  <button type="button" class="qty__btn" data-line-change="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
                </div>
                <button type="button" class="drawer-item__remove" data-line-change="{{ item.key }}" data-quantity="0">{{ 'cart.remove' | t }}</button>
              </div>
            </div>
            <div class="drawer-item__price">
              {%- if item.original_line_price != item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- liquid
        assign upsell_product = cart.items.first.product_id
      -%}
      <div class="cart-upsell" data-cart-upsell data-product-id="{{ upsell_product }}" hidden></div>

      <div class="cart-drawer__foot">
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart-summary__row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></p>
        {%- endfor -%}
        <p class="cart-summary__row cart-summary__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></p>
        <p class="cart-summary__small">{{ 'cart.taxes_and_shipping_drawer' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout">
          <button type="submit" name="checkout" class="btn btn--orange btn--lg">{% render 'icon', name: 'lock', icon_size: 16 %} {{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="cart-drawer__view">{{ 'products.view_cart' | t }}</a>
      </div>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p class="empty-state">{{ 'cart.empty' | t }}</p>
        <div class="btn-row">
          <a href="/collections/dogs" class="btn btn--orange">{{ 'cart.shop_dogs' | t }}</a>
          <a href="/collections/cats" class="btn btn--teal">{{ 'cart.shop_cats' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{ "name": "Cart drawer" }
{% endschema %}
