<article class="section">
  <div class="page-width page-width--narrow">
    <a href="{{ blog.url }}" class="link-arrow">&larr; {{ 'blogs.back' | t }}</a>
    <p class="eyebrow">{{ article.published_at | date: format: 'month_day_year' }}</p>
    <h1 class="section__title">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager' }}</div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
