<section class="section shop-by-pet">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}

    <div class="pet-panels">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pet' -%}
          <a href="{{ block.settings.collection.url | default: '#' }}" class="pet-panel pet-panel--{{ block.settings.color }}" {{ block.shopify_attributes }}>
            <span class="pet-panel__art">{% render 'illustration', name: block.settings.illustration %}</span>
            <span class="pet-panel__text">
              <span class="pet-panel__title">{{ block.settings.title }}</span>
              <span class="pet-panel__sub">{{ block.settings.subtitle }} &rarr;</span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <ul class="category-tiles">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.collection.url | default: '#' }}" class="category-tile">
              {% render 'icon', name: block.settings.icon, icon_size: 22 %}
              <span>{{ block.settings.title | default: block.settings.collection.title }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by pet",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by pet" }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "Pet panel",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "For dogs" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Beds, walks, chews & more" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "illustration", "label": "Illustration", "default": "dog-back", "options": [
          { "value": "dog-back", "label": "Dog" },
          { "value": "cat-back", "label": "Cat" }
        ] },
        { "type": "select", "id": "color", "label": "Colour", "default": "orange", "options": [
          { "value": "orange", "label": "Orange" },
          { "value": "teal", "label": "Teal" }
        ] }
      ]
    },
    {
      "type": "category",
      "name": "Category tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "bed", "options": [
          { "value": "bed", "label": "Bed" },
          { "value": "toy", "label": "Toy" },
          { "value": "feeding", "label": "Feeding" },
          { "value": "grooming", "label": "Grooming" },
          { "value": "travel", "label": "Travel" },
          { "value": "walk", "label": "Walk" },
          { "value": "paw", "label": "Paw" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Shop by pet" }]
}
{% endschema %}
