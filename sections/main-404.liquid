<section class="section">
  <div class="page-width page-width--narrow text-center">
    <div class="not-found__art">{% render 'illustration', name: 'hero-pets' %}</div>
    <h1 class="section__title">{{ 'general.page_not_found' | t }}</h1>
    <p class="section__sub">{{ 'general.page_not_found_text' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--orange">{{ 'general.continue_shopping' | t }}</a>
  </div>
</section>

