{%- comment -%} Previous / next buttons for a [data-carousel]. Hidden by theme.js when everything fits. {%- endcomment -%}
<div class="carousel__nav" data-carousel-nav hidden>
  <button type="button" class="carousel__btn" data-carousel-prev aria-label="{{ 'general.carousel_previous' | t }}" disabled>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button type="button" class="carousel__btn" data-carousel-next aria-label="{{ 'general.carousel_next' | t }}">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>
