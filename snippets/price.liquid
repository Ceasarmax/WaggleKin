{%- liquid
  if variant == blank
    assign variant = product.selected_or_first_available_variant
  endif
-%}
<div class="price{% if variant.compare_at_price > variant.price %} price--sale{% endif %}">
  <span class="visually-hidden">{% if variant.compare_at_price > variant.price %}{{ 'products.sale_price' | t }}{% else %}{{ 'products.regular_price' | t }}{% endif %}</span>
  <span class="price__current">
    {%- if product.price_varies and show_from -%}
      {%- assign min_price = product.price_min | money -%}
      {{ 'products.from_price' | t: price: min_price }}
    {%- else -%}
      {{ variant.price | money }}
    {%- endif -%}
  </span>
  {%- if variant.compare_at_price > variant.price -%}
    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="price__compare">{{ variant.compare_at_price | money }}</s>
  {%- endif -%}
</div>
