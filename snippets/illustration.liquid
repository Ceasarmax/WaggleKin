      <circle cx="100" cy="106" r="7" fill="#2DB3A3"/>
    </svg>
  {%- when 'lick-mat' -%}
    <svg class="illo illo--product" viewBox="0 0 200 160" aria-hidden="true" focusable="false">
      <rect x="40" y="16" width="120" height="128" rx="30" fill="#EC5C86" stroke="#C93A64" stroke-width="5"/>
      <g fill="#fff">
        {%- for row in (0..3) -%}
          {%- for col in (0..3) -%}
            <circle cx="{{ col | times: 22 | plus: 67 }}" cy="{{ row | times: 22 | plus: 47 }}" r="5"/>
          {%- endfor -%}
        {%- endfor -%}
      </g>
    </svg>
  {%- when 'feeder' -%}
    <svg class="illo illo--product" viewBox="0 0 200 170" aria-hidden="true" focusable="false">
      <ellipse cx="100" cy="146" rx="64" ry="14" fill="#fff" stroke="#1F2A44" stroke-width="5"/>
      <ellipse cx="100" cy="144" rx="46" ry="7" fill="#E58A3A"/>
      <rect x="66" y="10" width="68" height="124" rx="18" fill="#1F2A44"/>
      <rect x="76" y="22" width="48" height="24" rx="6" fill="#2DB3A3"/>
      <circle cx="100" cy="76" r="7" fill="#F18C2B"/>
    </svg>
  {%- when 'feather-wand' -%}
    <svg class="illo illo--product" viewBox="0 0 200 170" aria-hidden="true" focusable="false">
      <path d="M30 156 L134 54" stroke="#1F2A44" stroke-width="6" stroke-linecap="round"/>
      <path d="M134 54 C126 30 134 16 146 12 C150 30 146 44 134 54 Z" fill="#EC5C86"/>
      <path d="M134 54 C150 36 166 36 178 42 C164 56 150 58 134 54 Z" fill="#2DB3A3"/>
      <path d="M134 54 C154 52 170 62 174 74 C156 74 142 66 134 54 Z" fill="#F18C2B"/>
    </svg>
  {%- when 'gel-mat' -%}
    <svg class="illo illo--product" viewBox="0 0 200 140" aria-hidden="true" focusable="false">
      <rect x="22" y="24" width="156" height="92" rx="14" fill="#86D2EE" stroke="#1F2A44" stroke-width="6"/>
      <g fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round">
        <path d="M42 52 C62 40 78 64 100 52 C122 40 138 64 158 52"/>
        <path d="M42 72 C62 60 78 84 100 72 C122 60 138 84 158 72"/>
        <path d="M42 92 C62 80 78 104 100 92 C122 80 138 104 158 92"/>
      </g>
    </svg>
  {%- when 'bottle' -%}
    <svg class="illo illo--product" viewBox="0 0 200 180" aria-hidden="true" focusable="false">
      <path d="M78 30 C80 14 120 14 122 30 Z" fill="#F5C842" stroke="#1F2A44" stroke-width="5" stroke-linejoin="round"/>
      <rect x="72" y="30" width="56" height="8" rx="3" fill="#1F2A44"/>
      <rect x="78" y="38" width="44" height="130" rx="22" fill="#2DB3A3" stroke="#1F2A44" stroke-width="6"/>
      <rect x="92" y="58" width="16" height="78" rx="8" fill="#9EE3DA"/>
    </svg>
  {%- else -%}
    <svg class="illo illo--product" viewBox="0 0 200 160" aria-hidden="true" focusable="false">
      <g fill="#F18C2B">
        <ellipse cx="100" cy="104" rx="34" ry="28"/>
        <ellipse cx="62" cy="70" rx="13" ry="17"/>
        <ellipse cx="86" cy="50" rx="13" ry="17"/>
        <ellipse cx="114" cy="50" rx="13" ry="17"/>
        <ellipse cx="138" cy="70" rx="13" ry="17"/>
      </g>
    </svg>
{%- endcase -%}
