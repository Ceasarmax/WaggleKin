      <ellipse cx="100" cy="82" rx="88" ry="40" fill="#E58A3A"/>
      <ellipse cx="100" cy="70" rx="88" ry="40" fill="#F2B27A"/>
      <ellipse cx="100" cy="68" rx="50" ry="20" fill="#FBDDBB"/>
      <path d="M78 66 C90 58 110 58 122 66" fill="none" stroke="#B5561A" stroke-width="4" stroke-linecap="round"/>
    </svg>
  {%- when 'brush' -%}
    <svg class="illo illo--product" viewBox="0 0 200 160" aria-hidden="true" focusable="false">
      <rect x="92" y="70" width="26" height="86" rx="13" transform="rotate(-18 105 113)" fill="#1F2A44"/>
      <rect x="60" y="66" width="104" height="14" rx="5" transform="rotate(-18 112 73)" fill="#F18C2B"/>
      <rect x="52" y="12" width="110" height="62" rx="24" transform="rotate(-18 107 43)" fill="#2DB3A3" stroke="#1F2A44" stroke-width="4"/>
      <g fill="#fff">
        <circle cx="72" cy="52" r="4"/><circle cx="88" cy="47" r="4"/><circle cx="104" cy="42" r="4"/><circle cx="120" cy="37" r="4"/><circle cx="136" cy="32" r="4"/>
        <circle cx="78" cy="66" r="4"/><circle cx="94" cy="61" r="4"/><circle cx="110" cy="56" r="4"/><circle cx="126" cy="51" r="4"/><circle cx="142" cy="46" r="4"/>
      </g>
    </svg>
  {%- when 'fountain' -%}
    <svg class="illo illo--product" viewBox="0 0 200 160" aria-hidden="true" focusable="false">
      <path d="M100 46 C100 26 86 20 76 30 M100 46 C100 26 114 20 124 30" fill="none" stroke="#2DB3A3" stroke-width="7" stroke-linecap="round"/>
