{%- comment -%}
  Brand illustrations as inline SVG.
  Usage: {% render 'illustration', name: 'hero-pets' %}
  Names: hero-pets, dog-back, cat-back, tv-bubbles, logo-mark,
         donut-bed, brush, fountain, lick-mat, feeder, feather-wand, gel-mat, bottle, paw
{%- endcomment -%}
{%- case name -%}
  {%- when 'logo-mark' -%}
    <svg class="illo illo--logo-mark" viewBox="0 0 660 720" aria-hidden="true" focusable="false">
      <circle cx="463" cy="435" r="190" fill="#F18C2B"/>
      <circle cx="463" cy="120" r="112" fill="#F18C2B"/>
      <ellipse cx="352" cy="140" rx="40" ry="88" transform="rotate(16 352 140)" fill="#C0601B"/>
      <ellipse cx="574" cy="140" rx="40" ry="88" transform="rotate(-16 574 140)" fill="#C0601B"/>
      <path d="M68 28 L162 102 L254 28 L240 170 L84 170 Z" fill="#2DB3A3" stroke="#2DB3A3" stroke-width="20" stroke-linejoin="round"/>
      <circle cx="162" cy="228" r="103" fill="#2DB3A3"/>
      <ellipse cx="162" cy="472" rx="148" ry="174" fill="#fff"/>
      <ellipse cx="162" cy="472" rx="142" ry="168" fill="#2DB3A3"/>
      <path d="M432 520 C440 600 420 662 345 668" fill="none" stroke="#2DB3A3" stroke-width="44" stroke-linecap="round"/>
      <path d="M200 528 C186 610 230 652 296 652 C338 652 368 626 386 600" fill="none" stroke="#F18C2B" stroke-width="52" stroke-linecap="round"/>
    </svg>
  {%- when 'hero-pets' -%}
    <svg class="illo illo--hero" viewBox="0 0 660 720" aria-hidden="true" focusable="false">
      <circle cx="463" cy="435" r="190" fill="#F18C2B"/>
      <circle cx="463" cy="120" r="112" fill="#F18C2B"/>
      <ellipse cx="352" cy="140" rx="40" ry="88" transform="rotate(16 352 140)" fill="#C0601B"/>
      <ellipse cx="574" cy="140" rx="40" ry="88" transform="rotate(-16 574 140)" fill="#C0601B"/>
      <path d="M68 28 L162 102 L254 28 L240 170 L84 170 Z" fill="#2DB3A3" stroke="#2DB3A3" stroke-width="20" stroke-linejoin="round"/>
      <circle cx="162" cy="228" r="103" fill="#2DB3A3"/>
      <ellipse cx="162" cy="472" rx="150" ry="176" fill="var(--color-peach)"/>
      <ellipse cx="162" cy="472" rx="142" ry="168" fill="#2DB3A3"/>
