      <path d="M200 528 C186 610 230 652 296 652 C338 652 368 626 386 600" fill="none" stroke="#F18C2B" stroke-width="52" stroke-linecap="round"/>
    </svg>
  {%- when 'dog-back' -%}
    <svg class="illo illo--pet" viewBox="0 0 200 260" aria-hidden="true" focusable="false">
      <ellipse cx="100" cy="178" rx="72" ry="72" fill="#FFF7EF"/>
      <circle cx="100" cy="72" r="50" fill="#FFF7EF"/>
      <ellipse cx="60" cy="72" rx="16" ry="30" transform="rotate(14 60 72)" fill="#1F2A44"/>
      <ellipse cx="140" cy="72" rx="16" ry="30" transform="rotate(-14 140 72)" fill="#1F2A44"/>
      <path d="M48 214 C24 220 22 250 50 250 C70 250 74 232 64 222" fill="none" stroke="#FFF7EF" stroke-width="18" stroke-linecap="round"/>
    </svg>
  {%- when 'cat-back' -%}
    <svg class="illo illo--pet" viewBox="0 0 200 260" aria-hidden="true" focusable="false">
      <path d="M58 10 L92 40 L130 10 L126 70 L64 70 Z" fill="#FFF7EF" stroke="#FFF7EF" stroke-width="10" stroke-linejoin="round"/>
      <circle cx="94" cy="88" r="42" fill="#FFF7EF"/>
      <ellipse cx="94" cy="184" rx="64" ry="70" fill="#FFF7EF"/>
      <path d="M150 220 C176 214 180 186 166 172" fill="none" stroke="#FFF7EF" stroke-width="16" stroke-linecap="round"/>
    </svg>
  {%- when 'tv-bubbles' -%}
    <svg class="illo illo--tv" viewBox="0 0 440 340" aria-hidden="true" focusable="false">
