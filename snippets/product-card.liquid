{%- comment -%}
  Product card used in grids. Usage: {% render 'product-card', product: product %}
  Badge: tag "badge:Bestseller" / "badge:New", or automatic "Save X%" when on sale.
  Pass eager: true for the first row of a grid so the largest above-the-fold image isn't lazy-loaded.
{%- endcomment -%}
{%- liquid
  capture illo
    render 'product-illustration-key', product: product
  endcapture
  assign illo_parts = illo | strip | split: '|'
  assign illo_name = illo_parts[0]
  assign illo_bg = illo_parts[1]

  assign badge = ''
  assign badge_style = 'navy'
  for tag in product.tags
    if tag contains 'badge:'
      assign badge = tag | remove: 'badge:' | strip
    endif
  endfor
  assign variant = product.selected_or_first_available_variant
  if badge == '' and variant.compare_at_price > variant.price
    assign saving = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
    assign badge = 'products.save_percent' | t: percent: saving
    assign badge_style = 'pink'
  elsif badge contains 'New' or badge contains 'new'
    assign badge_style = 'teal'
  endif
-%}
{%- liquid
  assign card_url = product.url | within: collection
-%}
<article class="product-card">
  <a href="{{ card_url }}" class="product-card__media product-card__media--{{ illo_bg }}{% if product.featured_media %} product-card__media--photo{% endif %}" tabindex="-1" aria-hidden="true">
    {%- if badge != '' -%}
      <span class="badge badge--{{ badge_style }}">{{ badge }}</span>
    {%- endif -%}
    {%- if product.featured_media -%}
      {%- capture card_alt -%}{% render 'media-alt', media: product.featured_media, product: product %}{%- endcapture -%}
      {%- if eager -%}
        {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600', class: 'product-card__img', alt: card_alt }}
      {%- else -%}
        {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 450, 600', class: 'product-card__img', alt: card_alt }}
      {%- endif -%}
    {%- else -%}
      {% render 'illustration', name: illo_name %}
    {%- endif -%}
  </a>
  <div class="product-card__body">
    {%- if product.type != blank -%}
      <p class="product-card__type">{{ product.type }}</p>
    {%- endif -%}
    <h3 class="product-card__title"><a href="{{ card_url }}">{{ product.title }}</a></h3>
    {% render 'delivery-badge', product: product %}
    <div class="product-card__footer">
      {% render 'price', product: product, show_from: true %}
      {%- if product.available == false -%}
        <span class="btn btn--sm btn--disabled">{{ 'products.sold_out' | t }}</span>
      {%- elsif product.has_only_default_variant or product.variants.size == 1 -%}
        {%- form 'product', product, class: 'js-add-to-cart' -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" class="btn btn--orange btn--sm">{{ 'products.add_to_cart' | t }}</button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ card_url }}" class="btn btn--outline btn--sm">{{ 'products.choose_options' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</article>
